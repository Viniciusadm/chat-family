rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function userTenant() {
      return get(userPath()).data.tenantId;
    }
    function memberId() {
      return get(userPath()).data.memberId;
    }
    function isTenantAdult() {
      return get(userPath()).data.role == 'adult';
    }
    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }
    function isExpoPushTokenCreate() {
      return request.resource.data.pushToken is string
        && request.resource.data.pushToken.matches('^ExponentPushToken\\[.+\\]$');
    }
    function deviceCreateKeys() {
      return request.resource.data.keys().hasOnly([
        'userId', 'tenantId', 'pushToken', 'publicKey',
        'approved', 'createdAt', 'lastActiveAt', 'sessionAt'
      ]);
    }
    function deviceOwnerUpdateKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'pushToken', 'lastActiveAt', 'sessionAt', 'publicKey'
      ]) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['publicKey']) ||
        !resource.data.keys().hasAny(['publicKey'])
      );
    }

    match /loginCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if request.auth != null;
    }

    match /tenants/{tenantId} {
      allow read: if request.auth != null && tenantId == userTenant();
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && tenantId == userTenant() && isTenantAdult();
    }

    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.tenantId == userTenant() && isTenantAdult())
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /chatList/{chatId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /keyBackups/{chatId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasAll(['ciphertext', 'iv', 'encVersion', 'createdAt']) &&
          request.resource.data.ciphertext is string &&
          request.resource.data.iv is string &&
          request.resource.data.encVersion is int;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /members/{memberDocId} {
      allow read: if request.auth != null && resource.data.tenantId == userTenant();
      allow create: if request.auth != null && (
        (request.auth.uid == memberDocId && request.resource.data.tenantId is string) ||
        (
          isTenantAdult() &&
          request.resource.data.tenantId == userTenant() &&
          request.resource.data.keys().hasAll(['tenantId', 'name', 'role', 'loginCode', 'createdAt'])
        )
      );
      allow update: if request.auth != null && (
        (resource.data.tenantId == userTenant() && isTenantAdult()) ||
        (
          memberId() == memberDocId &&
          resource.data.tenantId == userTenant() &&
          request.resource.data.tenantId == resource.data.tenantId &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.loginCode == resource.data.loginCode &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl', 'photoPath'])
        )
      );
      allow delete: if request.auth != null && resource.data.tenantId == userTenant() && isTenantAdult();
    }

    match /devices/{deviceId} {
      allow read: if request.auth != null && (
        !exists(/databases/$(database)/documents/devices/$(deviceId)) ||
        (
          resource.data.tenantId == userTenant() && (
            resource.data.userId == request.auth.uid ||
            isTenantAdult()
          )
        )
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.tenantId is string &&
        request.resource.data.approved is bool &&
        isExpoPushTokenCreate() &&
        deviceCreateKeys() &&
        !request.resource.data.keys().hasAny(['active']);
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.approved == resource.data.approved &&
        deviceOwnerUpdateKeys();
      allow delete: if request.auth != null && resource.data.tenantId == userTenant() && isTenantAdult();

      match /keyShares/{chatId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/devices/$(deviceId)).data.tenantId == userTenant() &&
          (
            get(/databases/$(database)/documents/devices/$(deviceId)).data.userId == request.auth.uid ||
            isTenantAdult()
          );
        allow create, update: if request.auth != null &&
          isTenantAdult() &&
          get(/databases/$(database)/documents/devices/$(deviceId)).data.tenantId == userTenant() &&
          request.resource.data.keys().hasAll([
            'ephemeralPublicKey', 'iv', 'ciphertext', 'wrappedBy', 'createdAt'
          ]);
        allow delete: if request.auth != null &&
          get(/databases/$(database)/documents/devices/$(deviceId)).data.tenantId == userTenant() &&
          isTenantAdult();
      }
    }

    match /chats/{chatId} {
      allow read: if request.auth != null &&
        resource.data.tenantId == userTenant() &&
        (memberId() in resource.data.participants || isTenantAdult());
      allow create: if request.auth != null &&
        request.resource.data.tenantId == userTenant() &&
        (memberId() in request.resource.data.participants || isTenantAdult()) &&
        request.resource.data.keys().hasAll([
          'tenantId', 'participants', 'isGroup', 'name',
          'createdAt', 'updatedAt'
        ]);
      allow update, delete: if request.auth != null &&
        resource.data.tenantId == userTenant() &&
        (memberId() in resource.data.participants || isTenantAdult());
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null &&
        chatDoc(chatId).data.tenantId == userTenant() &&
        memberId() in chatDoc(chatId).data.participants;
      allow create: if request.auth != null &&
        memberId() in chatDoc(chatId).data.participants &&
        request.resource.data.senderId == memberId() &&
        request.resource.data.tenantId == chatDoc(chatId).data.tenantId &&
        request.resource.data.tenantId == userTenant() &&
        request.resource.data.keys().hasAll([
          'tenantId', 'senderId', 'createdAt'
        ]) &&
        (
          request.resource.data.keys().hasAll(['ciphertext', 'iv', 'encVersion']) ||
          request.resource.data.keys().hasAny(['text']) ||
          request.resource.data.keys().hasAny(['audioUrl']) ||
          request.resource.data.keys().hasAny(['imageUrl'])
        );
      allow update: if false;
      allow delete: if request.auth != null &&
        chatDoc(chatId).data.tenantId == userTenant() &&
        memberId() in chatDoc(chatId).data.participants;
    }

    match /chats/{chatId}/reactions/{reactionId} {
      allow read: if request.auth != null &&
        chatDoc(chatId).data.tenantId == userTenant() &&
        memberId() in chatDoc(chatId).data.participants;
      allow create: if request.auth != null &&
        memberId() in chatDoc(chatId).data.participants &&
        request.resource.data.userId == memberId() &&
        request.resource.data.keys().hasAll(['messageId', 'userId', 'emoji', 'updatedAt']);
      allow update: if request.auth != null &&
        memberId() in chatDoc(chatId).data.participants &&
        resource.data.userId == memberId() &&
        request.resource.data.keys().hasOnly(['emoji', 'updatedAt']);
      allow delete: if request.auth != null &&
        memberId() in chatDoc(chatId).data.participants &&
        resource.data.userId == memberId();
    }
  }
}
